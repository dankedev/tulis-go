  "item": [
    {
      "name": "Public Content API (v1)",
      "description": "Public content delivery APIs. Rate-limited and scoped by subdomain or X-Workspace-ID header.",
      "item": [
        {
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace-ID",
                "value": "{{workspaceId}}",
                "description": "Workspace ID (UUID)"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "posts"
              ],
              "raw": "{{baseUrl}}/v1/posts?type=&taxonomy=&sort=published_at desc&page=1&per_page=10",
              "query": [
                {
                  "key": "type",
                  "value": "",
                  "description": "Filter by post type (e.g. post, page, custom-post-type)"
                },
                {
                  "key": "taxonomy",
                  "value": "",
                  "description": "Filter by taxonomy slug"
                },
                {
                  "key": "sort",
                  "value": "published_at desc",
                  "description": "Sort order"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Returns a paginated list of published posts for the workspace."
          },
          "response": []
        },
