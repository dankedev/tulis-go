# .env.example for Kontent backend
# Copy this file to .env and fill in real values.

# Application environment (development, production, test, etc.)
APP_ENV=development

# Port on which the server will listen
APP_PORT=8080

# Database connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=konten

# JWT secret for signing tokens (replace with a strong secret in production)
JWT_SECRET=super-secret-key

# JWT token expiry in hours
JWT_EXPIRY_HOURS=24

# Workspace restricted mode
# When true: user registration does NOT auto-create a workspace.
# New users must be assigned to an existing workspace by a workspace owner/admin.
# When false (default): each registration auto-creates a personal workspace.
WORKSPACE_RESTRICTED=false

# Allow new user registration
# When true (default): registration endpoint is accessible and users can sign up.
# When false: registration is disabled (endpoint returns 404, frontend shows 404 page).
ALLOW_REGISTRATION=true

# Cloudflare R2 Storage (S3-compatible)
# If not configured, local filesystem storage will be used
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=konten-media
R2_PUBLIC_URL=

# Public API subdomain configuration
API_HOST=api.tulis.org
